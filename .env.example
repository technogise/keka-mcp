# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
#
# Where to get these: Keka Global admin settings -> Integrations & Automations
# -> API access -> API key.

# OAuth2 client credentials + API key (grant_type=kekaapi, scope=kekaapi)
KEKA_CLIENT_ID=your_client_id_here
KEKA_CLIENT_SECRET=your_client_secret_here
KEKA_API_KEY=your_api_key_here

# Company data API base URL - NO trailing slash. This is where PSA/HRIS
# endpoints (/api/v1/psa/..., /api/v1/hris/...) are called.
# Example: https://yourcompany.keka.com
KEKA_BASE_URL=https://yourcompany.keka.com

# OAuth token endpoint. IMPORTANT: this is Keka's LOGIN host, which is a
# *different* host from KEKA_BASE_URL above and is not derivable from it -
# pick the one that matches your environment:
#   Production      : https://login.keka.com/connect/token
#   Demo/sandbox     : https://login.kekademo.com/connect/token
#   Dev environment  : https://login.kekad.com/connect/token
#   Staging          : https://login.kekastage.com/connect/token
#   UAT              : https://login.kekauat.com/connect/token
# Confirm the exact host for your sandbox/tenant with Keka support before
# running - it was not possible to verify which one your sandbox uses
# without live credentials.
KEKA_TOKEN_URL=https://login.kekademo.com/connect/token
